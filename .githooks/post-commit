#!/bin/sh
# Fold a deferred or late changelog bump into HEAD once. Never amend on
# unrelated staged edits to version files.
set -e
if [ "${SKIP_OUTLINER_CHANGELOG_AMEND:-}" = "1" ]; then
  exit 0
fi
cd "$(git rev-parse --show-toplevel)"
GIT_DIR="$(git rev-parse --git-dir)"
PENDING="$GIT_DIR/outliner-changelog-pending"
AMEND="$GIT_DIR/outliner-changelog-amend"
RELEASE_FILES="outliner-menu.js package.json package-lock.json changelog.html"

amend_release_files() {
  SKIP_OUTLINER_CHANGELOG=1 SKIP_OUTLINER_CHANGELOG_AMEND=1 \
    git commit --amend --no-edit --no-verify -- $RELEASE_FILES
}

if [ -f "$PENDING" ]; then
  rm -f "$PENDING" "$AMEND"
  if [ "${SKIP_OUTLINER_CHANGELOG:-}" = "1" ]; then
    exit 0
  fi
  if ! git diff --quiet -- $RELEASE_FILES; then
    echo "Unstaged changes in release files; deferred changelog bump skipped." >&2
    exit 0
  fi
  MSG="$(git log -1 --pretty=%B)"
  TMP="$(mktemp)"
  printf '%s\n' "$MSG" > "$TMP"
  node scripts/changelog-release.js --message-file "$TMP"
  rm -f "$TMP"
  git add -- $RELEASE_FILES
  if git diff --cached --quiet -- $RELEASE_FILES; then
    exit 0
  fi
  amend_release_files
  exit 0
fi

if [ ! -f "$AMEND" ]; then
  exit 0
fi
rm -f "$AMEND"

# Only amend leftovers our prepare-commit-msg hook staged for this commit.
if git diff --cached --quiet -- $RELEASE_FILES 2>/dev/null; then
  exit 0
fi
amend_release_files
