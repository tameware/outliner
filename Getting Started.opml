<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Getting Started</title>
    <dateModified>Tue, 10 Nov 2026 11:22:01 GMT</dateModified>
    <expansionState>1,29</expansionState>
  </head>
  <body>
    <outline text="How to use this outliner">
      <outline text="Click any line to edit. Press Enter for a new line, then Tab to indent — this is a nested outline, not a flat document."/>
      <outline text="Click ▸ or ▾ beside a parent to show or hide its children">
        <outline text="⌘→ / ⌘← will do the same"/>
        <outline text="⌘⌥→ expands this heading’s subheads completely"/>
        <outline text="⌘⌥← collapses this heading’s subheads completely"/>
        <outline text="View → Expand All / Collapse All affects the whole outline"/>
      </outline>
      <outline text="Keyboard">
        <outline text="On Windows or Linux, use Ctrl wherever you see ⌘"/>
        <outline text="Enter — new line below (same level, or first child if this line has subheads)"/>
        <outline text="Tab — indent under the line above; Shift+Tab — outdent"/>
        <outline text="Backspace at the start of a line — merge with the line above"/>
        <outline text="↑ / ↓ — Move to the previous or next line; ⌥↑ / ⌥↓ — at the same level"/>
        <outline text="Promote (⌘[) — lift this line’s children up beside it"/>
        <outline text="Demote (⌘]) — nest the following same-level lines under this one"/>
      </outline>
      <outline text="Edit the title above the outline to rename the document"/>
      <outline text="Open and Save">
        <outline text="File → Open… / Save — OPML on your computer (re-saves in place when the browser supports it)"/>
        <outline text="Cloud → Open… / Save / Save As… / Delete… — Open from or save to Google Drive after Sign in with Google"/>
        <outline text="Cloud → Copy read-only / editable link — distinct share URLs (not interchangeable)"/>
      </outline>
      <outline text="Edit → Find… / Replace… searches the outline"/>
      <outline text="Edit → Clear Outline empties the document"/>
      <outline text="View → Focus narrows the display to one branch; Unfocus shows everything again"/>
      <outline text="Features for bridge players">
        <outline text="!c !d !h !s — insert ♣ ♦ ♥ ♠"/>
        <outline text="PBN deals and auctions stay as text while you edit; View → Render PBN shows compass diagrams and bidding tables (deals like N:73.QJT…; auctions like [Auction “N”] …)"/>
      </outline>
      <outline text="Replace these tips with your own outline whenever you’re ready."/>
      <outline text="There’s no charge for using the app — it’s free as in beer."/>
      <outline text="If you have questions or suggestions, please post to the discussion forum:">
        <outline text="https://groups.google.com/g/tameware-outliner"/>
        <outline text="To join or to see messages, you must be signed in with a Google account."/>
      </outline>
    </outline>
  </body>
</opml>
